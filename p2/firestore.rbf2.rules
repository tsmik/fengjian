rules_version = '2';
// P2 (rbf2 / rbf2-staging) Security Rules — 依設計規格 v0.6 §D。
// 與 P1(renxiangbingfa) 的 firestore.rules 無關、獨立一份。
// 原則：無任何 `if true`、無 mobileUsers/getRules/teacher-shared 後門。
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function emailOf()    { return request.auth.token.email; }
    // role 來源＝白名單 allowedUsers/{email}（只有 admin 可寫）。
    // 不再讀 users/{uid}.role（本人可寫 → 會被自封 admin）。修補「role 自我升權洞」(v0.7 §6)。
    function wlRole()     { return exists(/databases/$(database)/documents/allowedUsers/$(emailOf()))
                              ? get(/databases/$(database)/documents/allowedUsers/$(emailOf())).data.role : null; }
    // bootstrap：擁有者 email 永遠是 admin，防止白名單設錯把自己鎖死（別人無法冒充此 Google email）。
    function isBootstrapAdmin() { return isSignedIn() && emailOf() == 'chaojentseng@gmail.com'; }
    function isStaff()    { return isBootstrapAdmin() || (isSignedIn() && (wlRole() == 'admin' || wlRole() == 'teacher')); }
    function isAdmin()    { return isBootstrapAdmin() || (isSignedIn() && wlRole() == 'admin'); }

    // 規則資料：登入可讀；teacher/admin 可寫
    match /observations/{obsId} {
      allow read:  if isSignedIn();
      allow write: if isStaff();
    }
    match /ruleSets/{setId} {
      allow read:  if isSignedIn();
      allow write: if isStaff();
      match /dims/{dimId} {
        allow read:  if isSignedIn();
        allow write: if isStaff();
      }
      // 套裝化的觀察庫（題目＋版面順序），每套裝各一份
      match /observations/{obsId} {
        allow read:  if isSignedIn();
        allow write: if isStaff();
      }
      match /obsmeta/{docId} {
        allow read:  if isSignedIn();
        allow write: if isStaff();
      }
    }
    match /spiceScript/{docId} {
      allow read:  if isSignedIn();
      allow write: if isStaff();
    }
    match /config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isStaff();
    }

    // 使用者主檔＋底下全部（reports / cases / cases/**/reports）：限本人。
    // 老師＝不同 uid → 對他人 cases 無任何權限（符合 §D「老師對 cases 無權」）。
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // 白名單：登入可讀；只有 admin 可寫
    match /allowedUsers/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // 其餘一律拒絕（無全開放 collection）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
